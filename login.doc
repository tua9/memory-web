  --memio-label-small-letter-spacing: 0px;
  --memio-label-small-line-height: 20px;
  --memio-primitives-blue: rgba(56, 169, 219, 1);
  --memio-primitives-border: rgba(227, 235, 230, 1);
  --memio-primitives-green: rgba(46, 125, 50, 1);
  --memio-primitives-hover: rgba(35, 101, 39, 1);
  --memio-primitives-ink: rgba(31, 41, 55, 1);
  --memio-primitives-mint: rgba(234, 248, 239, 1);
  --memio-primitives-muted: rgba(95, 107, 122, 1);
  --memio-primitives-page: rgba(248, 251, 248, 1);
  --memio-primitives-paleblue: rgba(234, 246, 252, 1);
  --memio-primitives-paleyellow: rgba(255, 247, 223, 1);
  --memio-primitives-teal: rgba(0, 155, 120, 1);
  --memio-primitives-white: rgba(255, 255, 255, 1);
  --memio-primitives-yellow: rgba(245, 185, 63, 1);
  --memio-semantic-color-blue: var(--memio-primitives-blue);
  --memio-semantic-color-border: var(--memio-primitives-border);
  --memio-semantic-color-green: var(--memio-primitives-green);
  --memio-semantic-color-hover: var(--memio-primitives-hover);
  --memio-semantic-color-ink: var(--memio-primitives-ink);
  --memio-semantic-color-mint: var(--memio-primitives-mint);
  --memio-semantic-color-muted: var(--memio-primitives-muted);
  --memio-semantic-color-page: var(--memio-primitives-page);
  --memio-semantic-color-paleblue: var(--memio-primitives-paleblue);
  --memio-semantic-color-paleyellow: var(--memio-primitives-paleyellow);
  --memio-semantic-color-teal: var(--memio-primitives-teal);
  --memio-semantic-color-white: var(--memio-primitives-white);
  --memio-semantic-color-yellow: var(--memio-primitives-yellow);
  --memio-semantic-radius-12: 12px;
  --memio-semantic-radius-16: 16px;
  --memio-semantic-radius-24: 24px;
  --memio-semantic-radius-32: 32px;
  --memio-semantic-radius-999: 999px;
  --memio-semantic-space-0: 0px;
  --memio-semantic-space-12: 12px;
  --memio-semantic-space-120: 120px;
  --memio-semantic-space-16: 16px;
  --memio-semantic-space-20: 20px;
  --memio-semantic-space-24: 24px;
  --memio-semantic-space-28: 28px;
  --memio-semantic-space-32: 32px;
  --memio-semantic-space-4: 4px;
  --memio-semantic-space-40: 40px;
  --memio-semantic-space-48: 48px;
  --memio-semantic-space-56: 56px;
  --memio-semantic-space-64: 64px;
  --memio-semantic-space-8: 8px;
  --memio-semantic-space-80: 80px;
  --memio-semantic-space-96: 96px;
  --memio-shadow-soft: 0px 8px 24px 0px rgba(31, 77, 51, 0.08);
}

:root {
  --animate-spin: spin 1s linear infinite;
}

.animate-fade-in {
  animation: fade-in 1s var(--animation-delay, 0s) ease forwards;
}

.animate-fade-up {
  animation: fade-up 1s var(--animation-delay, 0s) ease forwards;
}

.animate-marquee {
  animation: marquee var(--duration) infinite linear;
}

.animate-marquee-vertical {
  animation: marquee-vertical var(--duration) linear infinite;
}

.animate-shimmer {
  animation: shimmer 8s infinite;
}

.animate-spin {
  animation: var(--animate-spin);
}

@keyframes spin {
  to {
    transform: rotate(1turn);
  }
}

@keyframes image-glow {
  0% {
    opacity: 0;
    animation-timing-function: cubic-bezier(0.74, 0.25, 0.76, 1);
  }

  10% {
    opacity: 0.7;
    animation-timing-function: cubic-bezier(0.12, 0.01, 0.08, 0.99);
  }

  to {
    opacity: 0.4;
  }
}

@keyframes fade-in {
  0% {
    opacity: 0;
    transform: translateY(-10px);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes fade-up {
  0% {
    opacity: 0;
    transform: translateY(20px);
  }

  to {
    opacity: 1;
    transform: none;
  }
}

@keyframes shimmer {
  0%,
  90%,
  to {
    background-position: calc(-100% - var(--shimmer-width)) 0;
  }

  30%,
  60% {
    background-position: calc(100% + var(--shimmer-width)) 0;
  }
}

@keyframes marquee {
  0% {
    transform: translate(0);
  }

  to {
    transform: translateX(calc(-100% - var(--gap)));
  }
}

@keyframes marquee-vertical {
  0% {
    transform: translateY(0);
  }

  to {
    transform: translateY(calc(-100% - var(--gap)));
  }
}
