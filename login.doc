import { FormEvent, useState } from "react";

export const LoginFormSection = (): JSX.Element => {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [rememberMe, setRememberMe] = useState(false);

  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
  };

  return (
    <section
      aria-labelledby="login-heading"
      className="absolute top-[120px] left-[845px] w-[531px] h-[688px] bg-white rounded-[28px] overflow-hidden border border-solid border-[#e3ebe6]"
    >
      <h1
        id="login-heading"
        className="absolute top-10 left-11 w-[460px] [font-family:'Be_Vietnam_Pro-Bold',Helvetica] font-bold text-[#15233a] text-2xl tracking-[0] leading-[48px]"
      >
        Chào mừng bạn trở lại!
      </h1>
      <p className="absolute top-[86px] left-11 w-[460px] font-memio-body-default font-[number:var(--memio-body-default-font-weight)] text-memio-semantic-color-muted text-[length:var(--memio-body-default-font-size)] tracking-[var(--memio-body-default-letter-spacing)] leading-[var(--memio-body-default-line-height)] [font-style:var(--memio-body-default-font-style)]">
        Đăng nhập để tiếp tục học và luyện tập cùng Memio.
      </p>
      <form onSubmit={handleSubmit} noValidate>
        <label
          htmlFor="email"
          className="absolute top-[135px] left-11 w-[460px] [font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] font-semibold text-gray-800 text-xs tracking-[0] leading-[18px]"
        >
          Email
        </label>
        <input
          id="email"
          name="email"
          type="email"
          autoComplete="email"
          value={email}
          onChange={(event) => setEmail(event.target.value)}
          placeholder="you@example.com"
          aria-label="Email"
          className="absolute top-[161px] left-9 w-[460px] h-[54px] px-[15px] bg-white rounded-[13px] overflow-hidden border border-solid border-[#e3ebe6] [font-family:'Be_Vietnam_Pro-Regular',Helvetica] font-normal text-[#667085] text-sm tracking-[0] leading-5 outline-none focus:border-[#2e7d32] focus:ring-1 focus:ring-[#2e7d32]"
        />
        <label
          htmlFor="password"
          className="absolute top-[219px] left-11 w-[460px] [font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] font-semibold text-gray-800 text-xs tracking-[0] leading-[18px]"
        >
          Mật khẩu
        </label>
        <input
          id="password"
          name="password"
          type="password"
          autoComplete="current-password"
          value={password}
          onChange={(event) => setPassword(event.target.value)}
          placeholder="••••••••"
          aria-label="Mật khẩu"
          className="absolute top-[241px] left-9 w-[460px] h-[54px] px-[15px] bg-white rounded-[13px] overflow-hidden border border-solid border-[#e3ebe6] [font-family:'Be_Vietnam_Pro-Regular',Helvetica] font-normal text-[#667085] text-sm tracking-[0] leading-5 outline-none focus:border-[#2e7d32] focus:ring-1 focus:ring-[#2e7d32]"
        />
        <label className="absolute top-[301px] left-9 flex h-[20px] w-[245px] items-center gap-2 [font-family:'Be_Vietnam_Pro-Regular',Helvetica] font-normal text-[#667085] text-xs tracking-[0] leading-[18px]">
          <input
            type="checkbox"
            name="rememberMe"
            checked={rememberMe}
            onChange={(event) => setRememberMe(event.target.checked)}
            className="h-4 w-4 rounded-[4px] border border-solid border-[#e3ebe6] accent-[#2e7d32]"
          />
          <span>Duy trì đăng nhập trên thiết bị này</span>
        </label>
        <button
          type="button"
          className="absolute top-[308px] left-[377px] w-[200px] text-left [font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] font-semibold text-[#2e7d32] text-sm tracking-[0] leading-5"
        >
          Quên mật khẩu?
        </button>
        <button
          type="submit"
          className="absolute top-[344px] left-9 w-[460px] h-[54px] bg-[#2e7d32] rounded-[14px] overflow-hidden text-white [font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] font-semibold text-[15px] text-center tracking-[0] leading-6 transition-colors hover:bg-[#256b29] focus:outline-none focus:ring-2 focus:ring-[#2e7d32] focus:ring-offset-2"
        >
          Đăng nhập
        </button>
      </form>
      <div
        aria-hidden="true"
        className="absolute top-[424px] left-9 w-[460px] [font-family:'Be_Vietnam_Pro-Medium',Helvetica] font-medium text-[#667085] text-xs text-center tracking-[0] leading-[18px]"
      >
        hoặc
      </div>
      <button
        type="button"
        className="absolute top-[450px] left-11 w-[460px] h-[52px] bg-white rounded-[14px] overflow-hidden [font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] font-semibold text-gray-800 text-[15px] text-center tracking-[0] leading-6 transition-colors hover:bg-[#f8faf9] focus:outline-none focus:ring-2 focus:ring-[#2e7d32] focus:ring-offset-2"
      >
        <span className="absolute top-3.5 left-0 w-[460px]">
          Tiếp tục với Google
        </span>
        <span
          aria-hidden="true"
          className="absolute top-2.5 left-[115px] flex h-[26px] w-[26px] items-center justify-center rounded-[13px] bg-[#ddf2e4] [font-family:'Be_Vietnam_Pro-Bold',Helvetica] font-bold text-[#2e7d32] text-sm tracking-[0] leading-5"
        >
          G
        </span>
      </button>
      <p className="absolute top-[502px] left-[171px] w-[190px] [font-family:'Be_Vietnam_Pro-Regular',Helvetica] font-normal text-[#667085] text-[13px] text-center tracking-[0] leading-5">
        Chưa có tài khoản?
      </p>
      <button
        type="button"
        className="absolute top-[533px] left-[216px] w-[100px] [font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] font-semibold text-[#2e7d32] text-[13px] text-center tracking-[0] leading-5 focus:outline-none focus:ring-2 focus:ring-[#2e7d32] focus:ring-offset-2"
      >
        Đăng ký
      </button>
      <p className="absolute top-[605px] left-9 w-[460px] [font-family:'Be_Vietnam_Pro-Regular',Helvetica] font-normal text-[#667085] text-xs text-center tracking-[0] leading-[18px]">
        Không cần nhớ nhiều. Chỉ cần bắt đầu.
      </p>
    </section>
  );
};

module.exports = {
  content: ["./src/**/*.{html,js,ts,jsx,tsx}"],
  corePlugins: { preflight: true },
  theme: {
