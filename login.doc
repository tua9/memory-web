import { FormEvent, useState } from "react";
import vector6 from "./vector-6.svg";

type Feature = {
  title: string;
  description: string;
};

const features: Feature[] = [
  {
    title: "Học tập theo hành trình",
    description:
      "Mỗi bước tiến nhỏ giúp bạn tiến gần hơn đến mục tiêu của mình.",
  },
  {
    title: "Theo dõi tiến bộ",
    description: "Dễ dàng quản lý thói quen và duy trì động lực mỗi ngày.",
  },
  {
    title: "Phát triển bền vững",
    description: "Xây dựng những thay đổi tích cực theo cách phù hợp với bạn.",
  },
];

export const LearningJourneyIllustrationSection = (): JSX.Element => {
  return (
    <section
      aria-labelledby="learning-journey-title"
      className="absolute left-[61px] top-[150px] w-[610px] min-h-[590px]"
    >
      <div className="relative flex min-h-[590px] flex-col justify-center px-[62px]">
        <div className="absolute left-[112px] top-[12px] h-[286px] w-[286px] rounded-full bg-[#eaf8eff0]" />
        <div className="absolute bottom-[25px] left-[22px] h-[112px] w-[112px] rounded-full bg-[#f4c95d38]" />
        <div className="absolute right-[35px] top-[112px] h-[150px] w-[150px] rounded-full bg-[#eaf6fc]" />
        <div className="relative z-10 max-w-[480px]">
          <span className="mb-5 inline-flex rounded-full bg-[#eaf8ef] px-4 py-2 [font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] text-[13px] font-semibold leading-5 text-[#2e7d32]">
            Chào mừng bạn đến với Memio
          </span>
          <h1
            id="learning-journey-title"
            className="mb-5 max-w-[470px] [font-family:'Be_Vietnam_Pro-Bold',Helvetica] text-[42px] font-bold leading-[1.2] tracking-[-0.5px] text-[#1f2937]"
          >
            Cùng bạn xây dựng hành trình phát triển bản thân
          </h1>
          <p className="mb-8 max-w-[430px] [font-family:'Be_Vietnam_Pro-Regular',Helvetica] text-[17px] leading-7 text-[#667085]">
            Tạo thói quen tốt, khám phá tiềm năng và biến những mục tiêu nhỏ
            thành kết quả lớn mỗi ngày.
          </p>
          <ul
            className="relative z-10 space-y-4"
            aria-label="Lợi ích của Memio"
          >
            {features.map((feature) => (
              <li key={feature.title} className="flex items-start gap-3">
                <span
                  aria-hidden="true"
                  className="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#2e7d32] text-sm font-bold text-white"
                >
                  ✓
                </span>
                <div>
                  <h2 className="[font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] text-[15px] font-semibold leading-6 text-[#1f2937]">
                    {feature.title}
                  </h2>
                  <p className="[font-family:'Be_Vietnam_Pro-Regular',Helvetica] text-[13px] leading-5 text-[#667085]">
                    {feature.description}
                  </p>
                </div>
              </li>
            ))}
          </ul>
        </div>
        <div
          aria-hidden="true"
          className="absolute bottom-[18px] right-[72px] z-10 flex h-[150px] w-[150px] items-center justify-center rounded-[44px] bg-white shadow-memio-shadow-soft"
        >
          <div className="relative h-[88px] w-[88px] rounded-[28px] bg-[#eaf8ef]">
            <div className="absolute left-[20px] top-[20px] h-[48px] w-[48px] rounded-full bg-[#2e7d32]" />
            <div className="absolute left-[35px] top-[33px] h-[19px] w-[8px] rotate-[-45deg] rounded-full border-b-[3px] border-l-[3px] border-white" />
          </div>
        </div>
      </div>
    </section>
  );
};

export const LoginFormSection = (): JSX.Element => {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [rememberMe, setRememberMe] = useState(false);
  const [showPassword, setShowPassword] = useState(false);
  const [error, setError] = useState("");
  const [submitted, setSubmitted] = useState(false);

  const handleSubmit = (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault();
    setSubmitted(false);

    if (!email.trim() || !password) {
      setError("Vui lòng nhập đầy đủ email và mật khẩu.");
      return;
    }

    setError("");
    setSubmitted(true);
  };

  return (
    <section
      aria-labelledby="login-title"
      className="absolute left-[790px] top-[155px] w-[500px]"
    >
      <div className="relative rounded-[24px] bg-white px-[54px] py-[44px] shadow-memio-shadow-soft">
        <div className="mb-8">
          <h2
            id="login-title"
            className="[font-family:'Be_Vietnam_Pro-Bold',Helvetica] text-[30px] font-bold leading-10 text-[#1f2937]"
          >
            Đăng nhập
          </h2>
          <p className="mt-2 [font-family:'Be_Vietnam_Pro-Regular',Helvetica] text-[14px] leading-6 text-[#667085]">
            Chào mừng bạn quay trở lại với Memio
          </p>
        </div>
        <form onSubmit={handleSubmit} noValidate>
          <div className="mb-5">
            <label
              htmlFor="email"
              className="mb-2 block [font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] text-[13px] font-semibold leading-5 text-[#1f2937]"
            >
              Email
            </label>
            <input
              id="email"
              name="email"
              type="email"
              autoComplete="email"
              value={email}
              onChange={(event) => setEmail(event.target.value)}
              placeholder="Nhập email của bạn"
              className="h-12 w-full rounded-[12px] border border-[#e3ebe6] px-4 [font-family:'Be_Vietnam_Pro-Regular',Helvetica] text-[14px] leading-5 text-[#1f2937] placeholder:text-[#98a2b3] focus:border-[#2e7d32] focus:ring-2 focus:ring-[#2e7d3230]"
            />
          </div>
          <div className="mb-3">
            <label
              htmlFor="password"
              className="mb-2 block [font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] text-[13px] font-semibold leading-5 text-[#1f2937]"
            >
              Mật khẩu
            </label>
            <div className="relative">
              <input
                id="password"
                name="password"
                type={showPassword ? "text" : "password"}
                autoComplete="current-password"
                value={password}
                onChange={(event) => setPassword(event.target.value)}
                placeholder="Nhập mật khẩu"
                className="h-12 w-full rounded-[12px] border border-[#e3ebe6] px-4 pr-12 [font-family:'Be_Vietnam_Pro-Regular',Helvetica] text-[14px] leading-5 text-[#1f2937] placeholder:text-[#98a2b3] focus:border-[#2e7d32] focus:ring-2 focus:ring-[#2e7d3230]"
              />
              <button
                type="button"
                onClick={() => setShowPassword((value) => !value)}
                aria-label={showPassword ? "Ẩn mật khẩu" : "Hiện mật khẩu"}
                className="absolute right-3 top-1/2 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-md text-[#667085] hover:bg-[#eaf8ef] hover:text-[#2e7d32]"
              >
                {showPassword ? "⌣" : "◉"}
              </button>
            </div>
          </div>
          <div className="mb-7 flex items-center justify-between">
            <label className="flex cursor-pointer items-center gap-2 [font-family:'Be_Vietnam_Pro-Regular',Helvetica] text-[13px] leading-5 text-[#1f2937]">
              <input
                type="checkbox"
                checked={rememberMe}
                onChange={(event) => setRememberMe(event.target.checked)}
                className="h-5 w-5 rounded-[5px] border-2 border-[#e3ebe6] accent-[#2e7d32] focus:ring-2 focus:ring-[#2e7d3230]"
              />
              Duy trì đăng nhập
            </label>
            <a
              href="#forgot-password"
              className="[font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] text-[13px] font-semibold leading-5 text-[#2e7d32] hover:text-[#236527]"
            >
              Quên mật khẩu?
            </a>
          </div>
          {error && (
            <p
              role="alert"
              className="mb-4 rounded-[8px] bg-[#fff1f0] px-3 py-2 [font-family:'Be_Vietnam_Pro-Regular',Helvetica] text-[13px] leading-5 text-[#b42318]"
            >
              {error}
            </p>
          )}

          {submitted && (
            <p
              role="status"
              className="mb-4 rounded-[8px] bg-[#eaf8ef] px-3 py-2 [font-family:'Be_Vietnam_Pro-Regular',Helvetica] text-[13px] leading-5 text-[#2e7d32]"
            >
              Đăng nhập thành công.
            </p>
          )}

          <button
            type="submit"
            className="h-12 w-full rounded-[12px] bg-[#2e7d32] [font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] text-[15px] font-semibold leading-6 text-white transition-colors hover:bg-[#236527] focus:outline-none focus:ring-2 focus:ring-[#2e7d3266] focus:ring-offset-2"
          >
            Đăng nhập
          </button>
        </form>
        <div className="my-7 flex items-center gap-3" aria-hidden="true">
          <div className="h-px flex-1 bg-[#e3ebe6]" />
          <span className="[font-family:'Be_Vietnam_Pro-Regular',Helvetica] text-[12px] text-[#98a2b3]">
            hoặc
          </span>
          <div className="h-px flex-1 bg-[#e3ebe6]" />
        </div>
        <p className="text-center [font-family:'Be_Vietnam_Pro-Regular',Helvetica] text-[13px] leading-5 text-[#667085]">
          Chưa có tài khoản?{" "}
          <a
            href="#register"
            className="[font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] font-semibold text-[#2e7d32] hover:text-[#236527]"
          >
            Đăng ký ngay
          </a>
        </p>
      </div>
    </section>
  );
};

export const LoginDesktop = (): JSX.Element => {
  return (
    <main className="relative min-h-[900px] w-full min-w-[1024px] overflow-hidden bg-[#f8fbf8]">
      <div className="absolute left-[55px] top-[85px] h-[170px] w-[170px] rounded-[85px] bg-[#ddf2e4b2]" />
      <div className="absolute left-[1210px] top-[60px] h-[110px] w-[110px] rounded-[55px] bg-[#f4c95d47]" />
      <div className="absolute left-[1260px] top-[690px] h-[150px] w-[150px] rounded-[75px] bg-[#f6d7c747]" />
      <a
        href="/"
        aria-label="Memio trang chủ"
        className="absolute left-16 top-[34px] flex w-[180px] items-center gap-[var(--memio-semantic-space-12)]"
      >
        <span className="relative h-11 w-11 bg-[url(/vector-5.svg)] bg-[100%_100%]">
          <img
            className="absolute left-[20.45%] top-[22.9%] h-[77.1%] w-[79.55%]"
            alt=""
            src={vector6}
          />
        </span>
        <span className="relative w-[124px] [font-family:'Be_Vietnam_Pro-Bold',Helvetica] text-[22px] font-bold leading-8 text-[#2e7d32]">
          Memio
        </span>
      </a>
      <p className="absolute left-[1050px] top-[45px] w-[170px] text-right [font-family:'Be_Vietnam_Pro-Regular',Helvetica] text-[13px] leading-5 text-[#667085]">
        Chưa có tài khoản?
      </p>
      <a
        href="#register"
        className="absolute left-[1240px] top-[34px] flex h-11 w-[136px] items-center justify-center rounded-[14px] bg-white [font-family:'Be_Vietnam_Pro-SemiBold',Helvetica] text-[15px] font-semibold leading-6 text-[#2e7d32] shadow-sm hover:bg-[#eaf8ef]"
      >
        Đăng ký
      </a>
      <LearningJourneyIllustrationSection />
      <LoginFormSection />
    </main>
  );
};

export default LoginDesktop;

